# บ่อดี (BODI) — Environment Variables Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with secrets to version control.

# PostgreSQL Connection String (e.g. Supabase, Neon, Railway, or local PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/bodi_db?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/bodi_dev?schema=public"

# Optional: Direct connection URL for migrations when using PgBouncer / Neon connection pooling
# DIRECT_URL="postgresql://username:password@localhost:5432/bodi_dev?schema=public"

# Node Environment
NODE_ENV="development"

# App URL for local development
VITE_APP_URL="http://localhost:5173"
